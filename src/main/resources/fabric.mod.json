{
	"schemaVersion": 1,
	"id": "cellcraft",
	"version": "${version}",
	"name": "cellcraft",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/cellcraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "cellcraft.Cellcraft",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "cellcraft.client.CellcraftClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "cellcraft.client.CellcraftDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"cellcraft.mixins.json",
		{
			"config": "cellcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}